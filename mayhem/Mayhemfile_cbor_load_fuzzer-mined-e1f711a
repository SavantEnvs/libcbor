project: savantenvs/libcbor
# In-process libFuzzer harness over libcbor's decoder: it reads a raw CBOR byte stream via
# cbor_load() and, on a successful decode, exercises cbor_describe / cbor_serialize_alloc / cbor_copy
# on the resulting item tree. Adapted from upstream oss-fuzz/cbor_load_fuzzer.cc: the first two input bytes pick which allocation in cbor_copy / cbor_copy_definite fails (0 = none), the rest is the CBOR stream.
target: cbor_load_fuzzer-mined-e1f711a

cmds:
  - cmd: /mayhem/cbor_load_fuzzer
    libfuzzer: true
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/cbor_load_fuzzer-mined-e1f711a/testsuite
